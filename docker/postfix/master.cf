# ============================================================================
# Postfix master.cf — service definitions.
#
#   25  smtp        inbound mail from other MTAs (no auth, anti-relay enforced)
#   587 submission  authenticated client send (STARTTLS required)
#   465 smtps       authenticated client send (implicit TLS)
# ============================================================================
# service type  private unpriv  chroot  wakeup  maxproc command + args
# ============================================================================

smtp      inet  n       -       n       -       -       smtpd

submission inet n       -       n       -       -       smtpd
  -o syslog_name=postfix/submission
  -o smtpd_tls_security_level=encrypt
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_tls_auth_only=yes
  -o smtpd_reject_unlisted_recipient=no
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
  # tempfail, NOT main.cf's global `accept`, and deliberately only on the
  # authenticated submission paths. Rspamd applies DKIM here, so if the milter
  # is unreachable `accept` means the message still goes out — unsigned, under
  # the domain's own name, with nothing logged on either side. You find out
  # from recipients' DMARC reports days later.
  #
  # tempfail defers instead: the client retries and the mail leaves once
  # signing works again. Deferring a message is far cheaper than publishing an
  # unauthenticated one.
  #
  # Inbound port 25 keeps `accept` on purpose — a milter outage must not bounce
  # legitimate mail arriving from the internet, where no signing decision of
  # ours is at stake.
  -o milter_default_action=tempfail

smtps     inet  n       -       n       -       -       smtpd
  -o syslog_name=postfix/smtps
  -o smtpd_tls_wrappermode=yes
  -o smtpd_sasl_auth_enable=yes
  -o smtpd_client_restrictions=permit_sasl_authenticated,reject
  -o smtpd_relay_restrictions=permit_sasl_authenticated,reject
  -o milter_macro_daemon_name=ORIGINATING
  # tempfail, NOT main.cf's global `accept`, and deliberately only on the
  # authenticated submission paths. Rspamd applies DKIM here, so if the milter
  # is unreachable `accept` means the message still goes out — unsigned, under
  # the domain's own name, with nothing logged on either side. You find out
  # from recipients' DMARC reports days later.
  #
  # tempfail defers instead: the client retries and the mail leaves once
  # signing works again. Deferring a message is far cheaper than publishing an
  # unauthenticated one.
  #
  # Inbound port 25 keeps `accept` on purpose — a milter outage must not bounce
  # legitimate mail arriving from the internet, where no signing decision of
  # ours is at stake.
  -o milter_default_action=tempfail

# --- Standard internal services --------------------------------------------
# Required by Postfix 3.4+ when maillog_file is set (logs via postlogd → stdout).
postlog   unix-dgram n  -       n       -       1       postlogd
pickup    unix  n       -       n       60      1       pickup
cleanup   unix  n       -       n       -       0       cleanup
qmgr      unix  n       -       n       300     1       qmgr
tlsmgr    unix  -       -       n       1000?   1       tlsmgr
rewrite   unix  -       -       n       -       -       trivial-rewrite
bounce    unix  -       -       n       -       0       bounce
defer     unix  -       -       n       -       0       bounce
trace     unix  -       -       n       -       0       bounce
verify    unix  -       -       n       -       1       verify
flush     unix  n       -       n       1000?   0       flush
proxymap  unix  -       -       n       -       -       proxymap
proxywrite unix -       -       n       -       1       proxymap
smtp      unix  -       -       n       -       -       smtp
relay     unix  -       -       n       -       -       smtp
showq     unix  n       -       n       -       -       showq
error     unix  -       -       n       -       -       error
retry     unix  -       -       n       -       -       error
discard   unix  -       -       n       -       -       discard
local     unix  -       n       n       -       -       local
virtual   unix  -       n       n       -       -       virtual
lmtp      unix  -       -       n       -       -       lmtp
anvil     unix  -       -       n       -       1       anvil
scache    unix  -       -       n       -       1       scache
