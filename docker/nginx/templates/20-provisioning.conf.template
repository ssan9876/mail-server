# --- IdM provisioning over the WireGuard tunnel -------------------------------
#
# A SECOND listener, bound to the tunnel address only. The public server block
# (10-https.conf.template) keeps its `location ^~ /api/v1/provisioning
# { return 404; }` completely untouched — this is not a hole in that block.
#
# Why this exists: the counterpart identity manager runs on a DIFFERENT host
# (see its docs/deployment/mail-server-transport.md). Provisioning's whole
# security argument is "a leaked token is useless from outside", which held
# because these routes lived only on the `internal` Docker bridge. Binding this
# listener to the WireGuard address keeps that sentence literally true across
# the host boundary, rather than replacing it with a weaker one: the
# provisioning port still never faces the public internet.
#
# ${WIREGUARD_ADDRESS} is substituted by the entrypoint, exactly like every
# other variable in these templates. It MUST be the tunnel address (e.g.
# 10.8.0.1) — never 0.0.0.0, which would publish provisioning on every
# interface and defeat the entire arrangement.
server {
    listen ${WIREGUARD_ADDRESS}:80;
    server_name _;

    # Required, not optional, now that provisioning is reachable from beyond
    # the internal Docker network. The IdM sync spec records that these routes
    # carry no application-level limiter of their own, and nginx's own limiter
    # never saw them before because the public block returns 404 first — so
    # this zone is the only request-volume control that exists on this path.
    limit_req zone=provisioning burst=20 nodelay;

    location /api/v1/provisioning {
        include /etc/nginx/includes/proxy.conf;
        proxy_pass http://backend:8000;
    }

    # Nothing else is served here. The tunnel exists for provisioning alone;
    # the dashboard, API and webmail all stay on the public block.
    location / {
        return 404;
    }
}
